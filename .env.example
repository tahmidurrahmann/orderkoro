# OrderPage Environment Variables
# Copy to .env.local for local development. Never commit real values or put secrets in clients/*.json.

# Telegram Bot API (shared bot across all seller clients)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google Service Account (for appending rows & updating status in Google Sheets via REST API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Upstash Redis (rate limiting, atomic order sequence, phone counters, 30-day order backup)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
