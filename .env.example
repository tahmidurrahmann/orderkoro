# Site Base URL (used for absolute metadataBase, Open Graph, and Twitter card URLs)
NEXT_PUBLIC_SITE_URL=https://kenakata-rho.vercel.app
NEXT_PUBLIC_CONTACT_URL=https://m.me/orderkoroshop

# OrderKoro Environment Variables
# Copy to .env.local for local development. Never commit real values or put secrets in clients/*.json.
# Set MOCK_INTEGRATIONS=1 to run offline with zero external network dependencies
MOCK_INTEGRATIONS=0

# Telegram Bot API (shared bot across all seller clients)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=

# Google Service Account (for appending rows & updating status in Google Sheets via REST API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Upstash Redis (rate limiting, atomic order sequence, idempotency, dead-letter queue)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
