{
  "name": "orderkoro",
  "version": "0.1.0",
  "private": true,
  "description": "Config-driven single-product COD order page template for Bangladeshi Facebook sellers",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-clients.mjs && node scripts/verify-no-secrets.mjs",
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vm": "node scripts/run-stage2-tests.mjs",
    "check:secrets": "node scripts/check-client-bundle.mjs",
    "init-sheet": "node scripts/init-sheet.mjs",
    "test-telegram": "node scripts/test-telegram.mjs",
    "replay-failed": "node scripts/replay-failed.mjs",
    "validate:clients": "node scripts/validate-clients.mjs",
    "new-client": "node scripts/new-client.mjs",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "clear-rate-limits": "node scripts/clear-rate-limits.mjs",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.40.0",
    "jose": "6.2.13",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.6.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
